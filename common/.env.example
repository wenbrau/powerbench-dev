# Copy to `.env` and fill in the key(s) for the providers you evaluate.
# Inspect reads this file automatically from the working directory.

# Anthropic (Claude models, and recommended judge)
ANTHROPIC_API_KEY=

# OpenAI (GPT models)
OPENAI_API_KEY=

# OpenRouter - REQUIRED for every pipeline script (runners, judges, build).
# common/or_key.py resolves this one name for the whole repo; `OR_KEY` is
# accepted as an alias for the older stage scripts but is no longer needed.
OPENROUTER_API_KEY=
# OR_KEY=

# Hugging Face READ token (huggingface.co/settings/tokens). Only used by
# 1_create_dataset/build/build_capability_probe.py to download the gated GPQA Diamond set.
HF_TOKEN=
