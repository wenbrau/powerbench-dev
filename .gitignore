# --- Secrets: never commit real keys ---
# Ignore every .env anywhere (root or any subdir), incl. variants like .env.local,
# but ALWAYS keep the *.env.example templates so others know which keys to set.
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!*.env.example
!**/.env.example

# OS / editor cruft
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
**/.venv/
.vscode

# Virtual environments
.venv/
venv/
env/
ENV/
**/.venv/

# Claude Code local state
/.claude

# Notes on what to do next
notes_w

# --- Other secrets / credential-bearing files ---
# Keys, certs, keystores
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
# Cloud / service-account credentials
*credentials*.json
*service-account*.json
*service_account*.json
gcp-*.json
aws-credentials
.aws/
# Package-manager / tooling auth
.npmrc
.pypirc
.netrc
# Generic secret files
secrets.*
*secret*.yaml
*secret*.yml
*.secrets
*.status

# PyMC posteriors: regenerable with 4_analysis/bayes_v6*.py, ~1.7GB, several over GitHub 100MB limit
4_analysis/bayes/*.nc
.playwright-mcp/

# MCMC posteriors: 70-150 MB netCDFs, regenerable from the archived bayes scripts.
# GitHub hard-rejects >100 MB; these were never meant to be tracked.
4_analysis/archive/bayes/

# Run files over GitHub's 100 MB limit are committed gzipped instead (common/runio.py reads
# either). This keeps the uncompressed twin out of the index; already-tracked plain runs are
# unaffected, and a small new one can still be added with `git add -f`.
current/runs/d1_v6r2_6models_pinned_off_7langs.jsonl
current/runs/d2_geobloc_v2_6models_pinned_off.jsonl

# capability probe bank: GPQA asks that its questions not be republished in plain text; the ids manifest is committed instead
current/banks/capability_probe*.jsonl
1_create_dataset/build/_cache_capability_probe/
current/runs/capability_probe_*.full.jsonl
